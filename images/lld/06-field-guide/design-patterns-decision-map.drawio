" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#575569;fontSize=10;fontColor=#575569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n28" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;translate one object&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#DCF1ED;strokeColor=#0F766E;fontColor=#0A5A53;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1072" y="520" width="150" height="56" as="geometry"/></mxCell><mxCell id="n33" value="one" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#575569;fontSize=10;fontColor=#575569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n30" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Facade&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;front door to many&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#DCF1ED;strokeColor=#0F766E;fontColor=#0A5A53;fontFamily=Helvetica;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1244" y="520" width="150" height="56" as="geometry"/></mxCell><mxCell id="n35" value="many" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#575569;fontSize=10;fontColor=#575569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n30" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="Holds children of that same interface?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#575569;fontColor=#18171F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1535" y="400" width="170" height="56" as="geometry"/></mxCell><mxCell id="n37" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;en